#!/usr/bin/env python3
"""claude-helper: one entry point for the tools in this folder.

  claude-helper report [--root DIR]     analyse your transcripts -> ~/.claude-helper/report.json + daily summary
  claude-helper backtest [--since DATE] how often each guard rule would have fired on your history
  claude-helper events [--days 7]       what the guard did and whether it worked (calls after a warning, re-blocks)
  claude-helper digest                  weekly Markdown digest -> ~/.claude-helper/digests/<date>.md
  claude-helper compare CHANGES.json    before/after metrics around dates you changed something
  claude-helper worktrees [--apply]     find (and optionally remove) finished git worktrees
  claude-helper install | uninstall     add / remove the guard hook (see install.py --help)
  claude-helper off | on                kill switch for the guard
"""
import json, os, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))
HOME = os.path.expanduser(os.getenv('CLAUDE_HELPER_HOME', '~/.claude-helper'))
PY = [sys.executable, '-I']


def run(script, *args):
    return subprocess.call(PY + [os.path.join(HERE, script), *args])


def summary(path):
    rep = json.load(open(path))
    w = rep['weeks']
    if not w:
        print('no Claude Code transcripts found (looked in ~/.claude/projects; use --root DIR for another place)')
        return
    print(f'\n{"day":10s} {"calls":>6s} {"est. $":>8s} {"$/commit":>8s} {"opus $%":>7s} {"weighted M":>10s} {"cache hit":>9s} {"avg ctx k":>9s} {">250k %":>7s} {"commits":>7s}')
    for k in sorted(w)[-8:]:
        r = w[k]
        f = lambda x, m=1, d=0: '-' if x is None else f'{x * m:.{d}f}'
        print(f'{k:10s} {r["calls"]:6d} {f(r.get("usd"), d=2):>8s} {f(r.get("usd_per_commit"), d=2):>8s} {f(r.get("opus_usd_share"), 100):>7s} '
              f'{r["weighted_M"]:10.1f} {f(r["cache_hit"], d=3):>9s} {f(r["avg_ctx_k"]):>9s} {f(r["pct_calls_gt250k"], d=1):>7s} {r["commits"]:7d}')
    print('\ncostliest sessions:')
    for s in rep['top_sessions'][:5]:
        print(f'  ${s.get("usd", 0):8.2f}  {s["weighted_M"]:6.1f}M  {s["calls"]:5d} calls  {s["project"]}')
    print(f'\nfull report: {path}   (est. $ = list-price API cost; weighted = input-token equivalents)')


def events(days):
    sys.path.insert(0, HERE)
    from outcomes import compute, render
    print(render(compute(days)))


def main():
    a = sys.argv[1:]
    cmd, rest = (a[0], a[1:]) if a else ('help', [])
    if cmd == 'report':
        out = os.path.join(HOME, 'report.json')
        rc = run('tokwaste.py', '--out', out, '--quiet', *rest)
        if rc == 0 and '--out' not in rest:
            summary(out)
        return rc
    if cmd == 'backtest':
        return run('backtest.py', *rest)
    if cmd == 'events':
        events(int(rest[rest.index('--days') + 1]) if '--days' in rest else 7)
        return 0
    if cmd == 'digest':
        return run('digest.py', *rest)
    if cmd == 'compare':
        if not rest:
            sys.exit('usage: claude-helper compare CHANGES.json [--days 7]   (see changes.example.json)')
        return run('compare.py', os.path.join(HOME, 'report.json'), *rest)
    if cmd == 'worktrees':
        return run('worktrees.py', *rest)
    if cmd == 'install':
        return run('install.py', *rest)
    if cmd == 'uninstall':
        return run('install.py', '--uninstall', *rest)
    if cmd in ('off', 'on'):
        p = os.path.join(HOME, 'OFF')
        os.makedirs(HOME, exist_ok=True)
        open(p, 'w').close() if cmd == 'off' else os.path.exists(p) and os.remove(p)
        print(f'guard {"disabled" if cmd == "off" else "enabled"}')
        return 0
    print(__doc__)
    return 0 if cmd in ('help', '-h', '--help') else 1


if __name__ == '__main__':
    sys.exit(main())
